# Settings for docker-compose.yml. Copy this file to .env (in this folder) and fill in the values:
#   Linux / Git Bash:    cp .env.example .env
#   Windows PowerShell:  Copy-Item .env.example .env
#
# .env contains passwords and tokens: it is in .gitignore - never commit it, never share it.
# After changing .env, apply the change with:  docker compose up -d
# After changing a password or token:          docker compose up -d --force-recreate jenkins
# Every variable must stay in the file, even when its value is empty.

# ------------------------------------------------------------------ Jenkins
# Port on this machine for the Jenkins web UI (8080 is used by the deployed application)
JENKINS_PORT=8079
# Address people use to open Jenkins, with the final /. On EC2: http://<EC2 public DNS name>:8079/
JENKINS_PUBLIC_URL=http://localhost:8079/
# Jenkins administrator. casc.yaml sets this password at every start - change it here, not in the web UI.
JENKINS_ADMIN_USER=admin
JENKINS_ADMIN_PASSWORD=
# Group number that owns the Docker socket, so Jenkins may run docker commands:
#   Windows / Docker Desktop:  0
#   Ubuntu:                    the number printed by:  getent group docker | cut -d: -f3
DOCKER_GID=0

# ------------------------------------------------------------------ GitHub
GITHUB_REPO_URL=https://github.com/Manivannanbgi007/simple-spring-boot-app.git
GITHUB_BRANCH=master
# Private repository only: your GitHub username and a fine-grained token (Contents: Read-only).
# Public repository: leave both empty.
GITHUB_USERNAME=
GITHUB_TOKEN=
# Any long random text. Enter the same text as "Secret" of the webhook in GitHub (README.md, Step 11).
# Create one with:  openssl rand -hex 32   (Windows PowerShell: see README.md, Step 5)
GITHUB_WEBHOOK_SECRET=

# ------------------------------------------------------------------ Docker Hub
# The Jenkinsfile pushes to <DOCKERHUB_USERNAME>/simple-spring-boot-app (see DOCKER_IMAGE in the Jenkinsfile)
DOCKERHUB_USERNAME=manivannanbgi
# Docker Hub -> Account settings -> Personal access tokens (permission: Read & Write)
DOCKERHUB_TOKEN=

# ------------------------------------------------------------------ SonarQube
SONARQUBE_PORT=9000
# Token Jenkins uses for the analysis. Leave empty for the first start; create it in SonarQube
# (README.md, Step 7), then apply it: docker compose up -d --force-recreate jenkins   (Step 8)
SONAR_TOKEN=
# Any long random text. Enter the same text as "Secret" of the Jenkins webhook in SonarQube (README.md, Step 7).
# Create one with:  openssl rand -hex 32   (Windows PowerShell: see README.md, Step 5)
SONAR_WEBHOOK_SECRET=
# Password of SonarQube's PostgreSQL database. Choose it once, before the first start, and keep it.
SONARQUBE_DB_PASSWORD=

# ------------------------------------------------------------------ ngrok (optional, only on a PC)
# Gives Jenkins a public address for the GitHub webhook: https://dashboard.ngrok.com -> Your Authtoken
NGROK_AUTHTOKEN=
